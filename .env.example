# Copy this file to .env and install dependencies with:
# python3 -m pip install -r requirements.txt
# Process environment variables override .env values.

# Material properties: density (kg/m^3), expansion (1/K).
ALUMINIUM_DENSITY_AT_REFERENCE_TEMPERATURE=2700
ALUMINIUM_VOLUMETRIC_THERMAL_EXPANSION=69e-6
COPPER_DENSITY_AT_REFERENCE_TEMPERATURE=8960
COPPER_VOLUMETRIC_THERMAL_EXPANSION=51e-6

# Reference temperature (K) at which the material densities above are specified.
# Used as the baseline for thermal expansion and to initialize diffusion coefficients.
# The simulation temperature is configured separately via TEMPERATURE.
REFERENCE_TEMPERATURE=300
# Arrhenius factors (m^2/s) and activation energies (J/mol).
ALUMINIUM_SELF_FACTOR=6.5e-5
ALUMINIUM_SELF_ACTIVATION_ENERGY=142e3
COPPER_SELF_FACTOR=7.8e-5
COPPER_SELF_ACTIVATION_ENERGY=196e3
ALUMINIUM_IN_COPPER_FACTOR=1.31e-5
ALUMINIUM_IN_COPPER_ACTIVATION_ENERGY=185.2e3
COPPER_IN_ALUMINIUM_FACTOR=2.9e-5
COPPER_IN_ALUMINIUM_ACTIVATION_ENERGY=130.2e3

# Simulation lengths (m), temperature (K), and times (s).
BORDER_COORDINATE=1e-4
INNER_OFFSET=1.1e-7
OUTER_OFFSET=1e-7
TEMPERATURE=600
# Domain size = SIZE_MULTIPLIER * BORDER_COORDINATE.
SIZE_MULTIPLIER=1.25
DELTA_COORDINATE=1e-8
DELTA_TIME=0.0682
STOP_TIME=1e12

# Logging period = LOG_PERIOD_STEPS * DELTA_TIME.
LOG_PERIOD_STEPS=1e4
# Optional: omit LOG_POINTS to log all grid points.
# LOG_POINTS=100
FILE_PREFIX=results/state
